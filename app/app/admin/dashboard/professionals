
"use client";

import Link from "next/link";
import { useState } from "react";

const demoProfessionals = [
  {
    id: 1,
    name: "John Professional",
    service: "Electrical",
    country: "Tanzania",
    location: "Dar es Salaam",
    verification: "Pending",
    status: "Active",
    rating: "4.8",
  },
  {
    id: 2,
    name: "Michael Services",
    service: "Plumbing",
    country: "Kenya",
    location: "Nairobi",
    verification: "Verified",
    status: "Active",
    rating: "4.6",
  },
];

export default function AdminProfessionalsPage() {
  const [search, setSearch] = useState("");
  const [filter, setFilter] = useState("All");

  const filteredProfessionals = demoProfessionals.filter((professional) => {
    const matchesSearch =
      professional.name.toLowerCase().includes(search.toLowerCase()) ||
      professional.service.toLowerCase().includes(search.toLowerCase()) ||
      professional.country.toLowerCase().includes(search.toLowerCase());

    const matchesFilter =
      filter === "All" || professional.verification === filter;

    return matchesSearch && matchesFilter;
  });

  return (
    <main
      style={{
        minHeight: "100vh",
        background: "#f5f7fb",
        padding: "25px 20px 50px",
        fontFamily: "Arial, sans-serif",
        color: "#172033",
      }}
    >
      <div
        style={{
          maxWidth: "1400px",
          margin: "0 auto",
        }}
      >
        {/* Header */}
        <div
          style={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
            gap: "15px",
            flexWrap: "wrap",
            marginBottom: "25px",
          }}
        >
          <div>
            <div
              style={{
                fontSize: "12px",
                color: "#6b7280",
                fontWeight: "700",
                marginBottom: "6px",
              }}
            >
              ADMIN CENTER / PROFESSIONALS
            </div>

            <h1
              style={{
                margin: 0,
                fontSize: "28px",
                fontWeight: "800",
              }}
            >
              Professionals
            </h1>

            <p
              style={{
                margin: "7px 0 0",
                color: "#6b7280",
                fontSize: "14px",
              }}
            >
              Manage professionals registered on FUNDI UNIVERSE.
            </p>
          </div>

          <Link
            href="/admin/dashboard"
            style={{
              textDecoration: "none",
              background: "#ffffff",
              color: "#374151",
              border: "1px solid #e5e7eb",
              padding: "10px 15px",
              borderRadius: "9px",
              fontSize: "14px",
              fontWeight: "700",
            }}
          >
            ← Admin Dashboard
          </Link>
        </div>

        {/* Summary Cards */}
        <div
          style={{
            display: "grid",
            gridTemplateColumns: "repeat(auto-fit, minmax(200px, 1fr))",
            gap: "15px",
            marginBottom: "25px",
          }}
        >
          <SummaryCard
            title="Total Professionals"
            value="0"
            icon="👨‍🔧"
          />

          <SummaryCard
            title="Verified"
            value="0"
            icon="✅"
          />

          <SummaryCard
            title="Pending Verification"
            value="0"
            icon="🕐"
          />

          <SummaryCard
            title="Suspended"
            value="0"
            icon="🚫"
          />
        </div>

        {/* Search and Filters */}
        <section
          style={{
            background: "#ffffff",
            border: "1px solid #e5e7eb",
            borderRadius: "15px",
            padding: "18px",
            marginBottom: "20px",
          }}
        >
          <div
            style={{
              display: "grid",
              gridTemplateColumns: "minmax(220px, 1fr) 180px",
              gap: "12px",
            }}
          >
            <input
              type="text"
              placeholder="Search professional, service or country..."
              value={search}
              onChange={(e) => setSearch(e.target.value)}
              style={{
                width: "100%",
                boxSizing: "border-box",
                padding: "12px 14px",
                border: "1px solid #d1d5db",
                borderRadius: "9px",
                fontSize: "14px",
                outline: "none",
              }}
            />

            <select
              value={filter}
              onChange={(e) => setFilter(e.target.value)}
              style={{
                padding: "12px 14px",
                border: "1px solid #d1d5db",
                borderRadius: "9px",
                fontSize: "14px",
                background: "#ffffff",
              }}
            >
              <option value="All">All Verification</option>
              <option value="Verified">Verified</option>
              <option value="Pending">Pending</option>
              <option value="Rejected">Rejected</option>
            </select>
          </div>
        </section>

        {/* Professionals Table */}
        <section
          style={{
            background: "#ffffff",
            border: "1px solid #e5e7eb",
            borderRadius: "15px",
            overflow: "hidden",
          }}
        >
          <div
            style={{
              padding: "18px 20px",
              borderBottom: "1px solid #e5e7eb",
            }}
          >
            <h2
              style={{
                margin: 0,
                fontSize: "18px",
              }}
            >
              Professional Directory
            </h2>

            <p
              style={{
                margin: "5px 0 0",
                color: "#6b7280",
                fontSize: "13px",
              }}
            >
              Professional accounts and verification status.
            </p>
          </div>

          <div style={{ overflowX: "auto" }}>
            <table
              style={{
                width: "100%",
                borderCollapse: "collapse",
                minWidth: "900px",
              }}
            >
              <thead>
                <tr
                  style={{
                    background: "#f9fafb",
                    textAlign: "left",
                  }}
                >
                  <th style={thStyle}>Professional</th>
                  <th style={thStyle}>Service</th>
                  <th style={thStyle}>Location</th>
                  <th style={thStyle}>Verification</th>
                  <th style={thStyle}>Status</th>
                  <th style={thStyle}>Rating</th>
                  <th style={thStyle}>Action</th>
                </tr>
              </thead>

              <tbody>
                {filteredProfessionals.length > 0 ? (
                  filteredProfessionals.map((professional) => (
                    <tr key={professional.id}>
                      <td style={tdStyle}>
                        <strong>{professional.name}</strong>
                      </td>

                      <td style={tdStyle}>
                        {professional.service}
                      </td>

                      <td style={tdStyle}>
                        {professional.location},{" "}
                        {professional.country}
                      </td>

                      <td style={tdStyle}>
                        <StatusBadge
                          type={professional.verification}
                        />
                      </td>

                      <td style={tdStyle}>
                        <StatusBadge
                          type={professional.status}
                        />
                      </td>

                      <td style={tdStyle}>
                        ⭐ {professional.rating}
                      </td>

                      <td style={tdStyle}>
                        <button
                          onClick={() =>
                            alert(
                              `Professional profile: ${professional.name}`
                            )
                          }
                          style={{
                            border: "1px solid #d1d5db",
                            background: "#ffffff",
                            borderRadius: "7px",
                            padding: "7px 11px",
                            cursor: "pointer",
                            fontSize: "12px",
                            fontWeight: "700",
                          }}
                        >
                          View
                        </button>
                      </td>
                    </tr>
                  ))
                ) : (
                  <tr>
                    <td
                      colSpan="7"
                      style={{
                        textAlign: "center",
                        padding: "45px 20px",
                        color: "#6b7280",
                      }}
                    >
                      No professionals found.
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </section>

        {/* Information */}
        <div
          style={{
            marginTop: "20px",
            padding: "15px",
            background: "#ffffff",
            border: "1px solid #e5e7eb",
            borderRadius: "12px",
            color: "#6b7280",
            fontSize: "13px",
          }}
        >
          <strong style={{ color: "#374151" }}>
            Next stage:
          </strong>{" "}
          This page will be connected to the Supabase{" "}
          <strong>professional_profiles</strong> table so that real
          professionals appear here.
        </div>
      </div>
    </main>
  );
}

function SummaryCard({ title, value, icon }) {
  return (
    <div
      style={{
        background: "#ffffff",
        border: "1px solid #e5e7eb",
        borderRadius: "14px",
        padding: "18px",
      }}
    >
      <div
        style={{
          fontSize: "25px",
          marginBottom: "10px",
        }}
      >
        {icon}
      </div>

      <div
        style={{
          fontSize: "26px",
          fontWeight: "800",
        }}
      >
        {value}
      </div>

      <div
        style={{
          marginTop: "5px",
          color: "#6b7280",
          fontSize: "13px",
        }}
      >
        {title}
      </div>
    </div>
  );
}

function StatusBadge({ type }) {
  let background = "#f3f4f6";
  let color = "#374151";

  if (type === "Verified") {
    background = "#ecfdf5";
    color = "#047857";
  }

  if (type === "Pending") {
    background = "#fffbeb";
    color = "#b45309";
  }

  if (type === "Rejected") {
    background = "#fef2f2";
    color = "#b91c1c";
  }

  if (type === "Active") {
    background = "#eff6ff";
    color = "#1d4ed8";
  }

  if (type === "Suspended") {
    background = "#fef2f2";
    color = "#b91c1c";
  }

  return (
    <span
      style={{
        display: "inline-block",
        background,
        color,
        padding: "5px 9px",
        borderRadius: "20px",
        fontSize: "11px",
        fontWeight: "700",
      }}
    >
      {type}
    </span>
  );
}

const thStyle = {
  padding: "13px 15px",
  fontSize: "12px",
  color: "#6b7280",
  borderBottom: "1px solid #e5e7eb",
  whiteSpace: "nowrap",
};

const tdStyle = {
  padding: "15px",
  fontSize: "13px",
  borderBottom: "1px solid #f0f1f3",
  whiteSpace: "nowrap",
};

