"use client";

import { useEffect, useState } from "react";
import Link from "next/link";
import { supabase } from "../../../lib/supabaseClient";

export default function AdminProfessionalsPage() {
  const [professionals, setProfessionals] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [search, setSearch] = useState("");
  const [filter, setFilter] = useState("All");

  useEffect(() => {
    loadProfessionals();
  }, []);

  async function loadProfessionals() {
    setLoading(true);
    setError("");

    const { data, error } = await supabase
      .from("professional_profiles")
      .select(`
        id,
        user_id,
        professional_name,
        full_name,
        professional_category,
        professional_title,
        country,
        city,
        location,
        email,
        phone,
        rating,
        total_reviews,
        verification_status,
        is_verified,
        is_active,
        is_available,
        created_at
      `)
      .order("created_at", { ascending: false });

    if (error) {
      console.error(error);
      setError(error.message);
      setProfessionals([]);
    } else {
      setProfessionals(data || []);
    }

    setLoading(false);
  }

  const filteredProfessionals = professionals.filter((professional) => {
    const name = (
      professional.professional_name ||
      professional.full_name ||
      ""
    ).toLowerCase();

    const category = (
      professional.professional_category || ""
    ).toLowerCase();

    const country = (
      professional.country || ""
    ).toLowerCase();

    const matchesSearch =
      name.includes(search.toLowerCase()) ||
      category.includes(search.toLowerCase()) ||
      country.includes(search.toLowerCase());

    const status =
      professional.verification_status ||
      (professional.is_verified ? "Verified" : "Pending");

    const matchesFilter =
      filter === "All" ||
      status.toLowerCase() === filter.toLowerCase();

    return matchesSearch && matchesFilter;
  });

  const totalProfessionals = professionals.length;

  const verifiedProfessionals = professionals.filter(
    (professional) =>
      professional.is_verified === true ||
      professional.verification_status?.toLowerCase() === "verified"
  ).length;

  const pendingProfessionals = professionals.filter(
    (professional) =>
      !professional.is_verified ||
      professional.verification_status?.toLowerCase() === "pending"
  ).length;

  const suspendedProfessionals = professionals.filter(
    (professional) => professional.is_active === false
  ).length;

  return (
    <main
      style={{
        minHeight: "100vh",
        background: "#f5f7fb",
        padding: "25px 20px 50px",
        fontFamily: "Arial, sans-serif",
        color: "#172033",
      }}
    >
      <div
        style={{
          maxWidth: "1400px",
          margin: "0 auto",
        }}
      >
        {/* Header */}
        <div
          style={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
            gap: "15px",
            flexWrap: "wrap",
            marginBottom: "25px",
          }}
        >
          <div>
            <div
              style={{
                fontSize: "12px",
                color: "#6b7280",
                fontWeight: "700",
                marginBottom: "6px",
              }}
            >
              ADMIN CENTER / PROFESSIONALS
            </div>

            <h1
              style={{
                margin: 0,
                fontSize: "28px",
                fontWeight: "800",
              }}
            >
              Professionals
            </h1>

            <p
              style={{
                margin: "7px 0 0",
                color: "#6b7280",
                fontSize: "14px",
              }}
            >
              Manage professionals registered on FUNDI UNIVERSE.
            </p>
          </div>

          <Link
            href="/admin/dashboard"
            style={{
              textDecoration: "none",
              background: "#ffffff",
              color: "#374151",
              border: "1px solid #e5e7eb",
              padding: "10px 15px",
              borderRadius: "9px",
              fontSize: "14px",
              fontWeight: "700",
            }}
          >
            ← Admin Dashboard
          </Link>
        </div>

        {/* Summary Cards */}
        <div
          style={{
            display: "grid",
            gridTemplateColumns:
              "repeat(auto-fit, minmax(200px, 1fr))",
            gap: "15px",
            marginBottom: "25px",
          }}
        >
          <SummaryCard
            title="Total Professionals"
            value={totalProfessionals}
            icon="👨‍🔧"
          />

          <SummaryCard
            title="Verified"
            value={verifiedProfessionals}
            icon="✅"
          />

          <SummaryCard
            title="Pending Verification"
            value={pendingProfessionals}
            icon="🕐"
          />

          <SummaryCard
            title="Suspended"
            value={suspendedProfessionals}
            icon="🚫"
          />
        </div>

        {/* Search / Filter */}
        <section
          style={{
            background: "#ffffff",
            border: "1px solid #e5e7eb",
            borderRadius: "15px",
            padding: "18px",
            marginBottom: "20px",
          }}
        >
          <div
            style={{
              display: "grid",
              gridTemplateColumns:
                "minmax(220px, 1fr) 190px auto",
              gap: "12px",
            }}
          >
            <input
              type="text"
              placeholder="Search professional, service or country..."
              value={search}
              onChange={(e) => setSearch(e.target.value)}
              style={{
                width: "100%",
                boxSizing: "border-box",
                padding: "12px 14px",
                border: "1px solid #d1d5db",
                borderRadius: "9px",
                fontSize: "14px",
                outline: "none",
              }}
            />

            <select
              value={filter}
              onChange={(e) => setFilter(e.target.value)}
              style={{
                padding: "12px 14px",
                border: "1px solid #d1d5db",
                borderRadius: "9px",
                fontSize: "14px",
                background: "#ffffff",
              }}
            >
              <option value="All">All Verification</option>
              <option value="Verified">Verified</option>
              <option value="Pending">Pending</option>
              <option value="Rejected">Rejected</option>
            </select>

            <button
              onClick={loadProfessionals}
              style={{
                padding: "12px 18px",
                border: "none",
                borderRadius: "9px",
                background: "#111827",
                color: "#ffffff",
                fontSize: "13px",
                fontWeight: "700",
                cursor: "pointer",
              }}
            >
              Refresh
            </button>
          </div>
        </section>

        {/* Error */}
        {error && (
          <div
            style={{
              background: "#fef2f2",
              border: "1px solid #fecaca",
              color: "#b91c1c",
              padding: "15px",
              borderRadius: "10px",
              marginBottom: "20px",
              fontSize: "13px",
            }}
          >
            <strong>Unable to load professionals.</strong>
            <div style={{ marginTop: "5px" }}>{error}</div>
          </div>
        )}

        {/* Table */}
        <section
          style={{
            background: "#ffffff",
            border: "1px solid #e5e7eb",
            borderRadius: "15px",
            overflow: "hidden",
          }}
        >
          <div
            style={{
              padding: "18px 20px",
              borderBottom: "1px solid #e5e7eb",
            }}
          >
            <h2
              style={{
                margin: 0,
                fontSize: "18px",
              }}
            >
              Professional Directory
            </h2>

            <p
              style={{
                margin: "5px 0 0",
                color: "#6b7280",
                fontSize: "13px",
              }}
            >
              Showing {filteredProfessionals.length} of{" "}
              {professionals.length} professionals.
            </p>
          </div>

          {loading ? (
            <div
              style={{
                padding: "50px 20px",
                textAlign: "center",
                color: "#6b7280",
              }}
            >
              Loading professionals...
            </div>
          ) : filteredProfessionals.length === 0 ? (
            <div
              style={{
                padding: "50px 20px",
                textAlign: "center",
                color: "#6b7280",
              }}
            >
              No professionals found.
            </div>
          ) : (
            <div style={{ overflowX: "auto" }}>
              <table
                style={{
                  width: "100%",
                  borderCollapse: "collapse",
                  minWidth: "1050px",
                }}
              >
                <thead>
                  <tr
                    style={{
                      background: "#f9fafb",
                      textAlign: "left",
                    }}
                  >
                    <th style={thStyle}>Professional</th>
                    <th style={thStyle}>Category</th>
                    <th style={thStyle}>Location</th>
                    <th style={thStyle}>Contact</th>
                    <th style={thStyle}>Verification</th>
                    <th style={thStyle}>Status</th>
                    <th style={thStyle}>Rating</th>
                  </tr>
                </thead>

                <tbody>
                  {filteredProfessionals.map((professional) => {
                    const name =
                      professional.professional_name ||
                      professional.full_name ||
                      "Unnamed Professional";

                    const verification =
                      professional.verification_status ||
                      (professional.is_verified
                        ? "Verified"
                        : "Pending");

                    const activeStatus =
                      professional.is_active === false
                        ? "Suspended"
                        : "Active";

                    return (
                      <tr key={professional.id}>
                        <td style={tdStyle}>
                          <strong>{name}</strong>

                          {professional.professional_title && (
                            <div
                              style={{
                                color: "#6b7280",
                                fontSize: "11px",
                                marginTop: "4px",
                              }}
                            >
                              {professional.professional_title}
                            </div>
                          )}
                        </td>

                        <td style={tdStyle}>
                          {professional.professional_category ||
                            "Not specified"}
                        </td>

                        <td style={tdStyle}>
                          {professional.city
                            ? `${professional.city}, `
                            : ""}
                          {professional.country ||
                            "Not specified"}
                        </td>

                        <td style={tdStyle}>
                          <div>
                            {professional.email || "No email"}
                          </div>

                          <div
                            style={{
                              color: "#6b7280",
                              fontSize: "11px",
                              marginTop: "4px",
                            }}
                          >
                            {professional.phone || "No phone"}
                          </div>
                        </td>

                        <td style={tdStyle}>
                          <StatusBadge type={verification} />
                        </td>

                        <td style={tdStyle}>
                          <StatusBadge type={activeStatus} />
                        </td>

                        <td style={tdStyle}>
                          ⭐ {Number(
                            professional.rating || 0
                          ).toFixed(1)}

                          <div
                            style={{
                              color: "#9ca3af",
                              fontSize: "11px",
                              marginTop: "3px",
                            }}
                          >
                            {professional.total_reviews || 0} reviews
                          </div>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          )}
        </section>
      </div>
    </main>
  );
}

function SummaryCard({ title, value, icon }) {
  return (
    <div
      style={{
        background: "#ffffff",
        border: "1px solid #e5e7eb",
        borderRadius: "14px",
        padding: "18px",
      }}
    >
      <div
        style={{
          fontSize: "25px",
          marginBottom: "10px",
        }}
      >
        {icon}
      </div>

      <div
        style={{
          fontSize: "26px",
          fontWeight: "800",
        }}
      >
        {value}
      </div>

      <div
        style={{
          marginTop: "5px",
          color: "#6b7280",
          fontSize: "13px",
        }}
      >
        {title}
      </div>
    </div>
  );
}

function StatusBadge({ type }) {
  const normalized = String(type || "").toLowerCase();

  let background = "#f3f4f6";
  let color = "#374151";

  if (normalized === "verified") {
    background = "#ecfdf5";
    color = "#047857";
  }

  if (normalized === "pending") {
    background = "#fffbeb";
    color = "#b45309";
  }

  if (normalized === "rejected") {
    background = "#fef2f2";
    color = "#b91c1c";
  }

  if (normalized === "active") {
    background = "#eff6ff";
    color = "#1d4ed8";
  }

  if (normalized === "suspended") {
    background = "#fef2f2";
    color = "#b91c1c";
  }

  return (
    <span
      style={{
        display: "inline-block",
        background,
        color,
        padding: "5px 9px",
        borderRadius: "20px",
        fontSize: "11px",
        fontWeight: "700",
      }}
    >
      {type}
    </span>
  );
}

const thStyle = {
  padding: "13px 15px",
  fontSize: "12px",
  color: "#6b7280",
  borderBottom: "1px solid #e5e7eb",
  whiteSpace: "nowrap",
};

const tdStyle = {
  padding: "15px",
  fontSize: "13px",
  borderBottom: "1px solid #f0f1f3",
  whiteSpace: "nowrap",
};
