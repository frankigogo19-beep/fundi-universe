"use client";

import { useEffect, useState } from "react";
import Link from "next/link";
import { supabase } from "../../lib/supabaseClient";

export default function ProfessionalDashboard() {
  const [requests, setRequests] = useState([]);
  const [loading, setLoading] = useState(true);
  const [message, setMessage] = useState("");

  useEffect(() => {
    fetchRequests();
  }, []);

  async function fetchRequests() {
    setLoading(true);

    const { data, error } = await supabase
      .from("job_requests")
      .select(`
        *,
        professional_profiles (
          id,
          full_name,
          professional_title,
          professional_category
        )
      `)
      .order("created_at", { ascending: false });

    if (error) {
      console.error(error);
      setMessage("Failed to load service requests.");
      setRequests([]);
    } else {
      setRequests(data || []);
    }

    setLoading(false);
  }

  async function updateStatus(id, status) {
    setMessage("");

    const { error } = await supabase
      .from("job_requests")
      .update({
        status,
        updated_at: new Date().toISOString(),
      })
      .eq("id", id);

    if (error) {
      console.error(error);
      setMessage("Failed to update request.");
      return;
    }

    setRequests((current) =>
      current.map((request) =>
        request.id === id
          ? {
              ...request,
              status,
              updated_at: new Date().toISOString(),
            }
          : request
      )
    );

    setMessage(`Request updated to ${status}.`);
  }

  async function updateNotes(id) {
    const notes = window.prompt("Enter your professional notes:");

    if (notes === null) {
      return;
    }

    const { error } = await supabase
      .from("job_requests")
      .update({
        professional_notes: notes,
        updated_at: new Date().toISOString(),
      })
      .eq("id", id);

    if (error) {
      console.error(error);
      setMessage("Failed to save notes.");
      return;
    }

    setRequests((current) =>
      current.map((request) =>
        request.id === id
          ? {
              ...request,
              professional_notes: notes,
              updated_at: new Date().toISOString(),
            }
          : request
      )
    );

    setMessage("Professional notes saved.");
  }

  function statusClass(status) {
    switch (status) {
      case "Accepted":
        return "status accepted";
      case "Rejected":
        return "status rejected";
      case "In Progress":
        return "status progress";
      case "Completed":
        return "status completed";
      default:
        return "status pending";
    }
  }

  return (
    <main className="dashboard-page">
      <div className="dashboard-container">

        <div className="dashboard-header">
          <div>
            <h1>Professional Dashboard</h1>
            <p>Manage service requests from customers.</p>
          </div>

          <Link href="/professionals" className="back-button">
            Find Professionals
          </Link>
        </div>

        {message && (
          <div className="dashboard-message">
            {message}
          </div>
        )}

        <section className="summary-grid">
          <div className="summary-card">
            <span>Total Requests</span>
            <strong>{requests.length}</strong>
          </div>

          <div className="summary-card">
            <span>Pending</span>
            <strong>
              {requests.filter((item) => item.status === "Pending").length}
            </strong>
          </div>

          <div className="summary-card">
            <span>In Progress</span>
            <strong>
              {requests.filter((item) => item.status === "In Progress").length}
            </strong>
          </div>

          <div className="summary-card">
            <span>Completed</span>
            <strong>
              {requests.filter((item) => item.status === "Completed").length}
            </strong>
          </div>
        </section>

        <section className="requests-section">
          <div className="section-heading">
            <h2>Service Requests</h2>
            <button
              onClick={fetchRequests}
              className="refresh-button"
            >
              Refresh
            </button>
          </div>

          {loading ? (
            <div className="empty-card">
              <p>Loading service requests...</p>
            </div>
          ) : requests.length === 0 ? (
            <div className="empty-card">
              <h3>No service requests yet</h3>
              <p>
                Customer requests will appear here when they request
                your services.
              </p>
            </div>
          ) : (
            <div className="requests-list">
              {requests.map((request) => (
                <article key={request.id} className="request-card">

                  <div className="request-top">
                    <div>
                      <h3>{request.title || "Service Request"}</h3>

                      <p className="request-id">
                        Request #{request.id}
                      </p>
                    </div>

                    <span className={statusClass(request.status)}>
                      {request.status || "Pending"}
                    </span>
                  </div>

                  <div className="request-grid">

                    <div className="request-field">
                      <label>Customer ID</label>
                      <p>
                        {request.customer_id || "Not connected yet"}
                      </p>
                    </div>

                    <div className="request-field">
                      <label>Category</label>
                      <p>{request.category || "Not specified"}</p>
                    </div>

                    <div className="request-field">
                      <label>Budget</label>
                      <p>
                        {request.budget
                          ? `${request.budget} ${request.currency || ""}`
                          : "Not specified"}
                      </p>
                    </div>

                    <div className="request-field">
                      <label>Requested Date</label>
                      <p>
                        {request.requested_date || "Not specified"}
                      </p>
                    </div>

                    <div className="request-field">
                      <label>Country</label>
                      <p>{request.country || "Not specified"}</p>
                    </div>

                    <div className="request-field">
                      <label>City</label>
                      <p>{request.city || "Not specified"}</p>
                    </div>

                    <div className="request-field">
                      <label>Location</label>
                      <p>{request.location || "Not specified"}</p>
                    </div>

                    <div className="request-field">
                      <label>Received</label>
                      <p>
                        {request.created_at
                          ? new Date(
                              request.created_at
                            ).toLocaleString()
                          : "Unknown"}
                      </p>
                    </div>

                  </div>

                  <div className="request-description">
                    <h4>Job Description</h4>
                    <p>
                      {request.description ||
                        "No job description provided."}
                    </p>
                  </div>

                  {request.customer_notes && (
                    <div className="notes-box">
                      <h4>Customer Notes</h4>
                      <p>{request.customer_notes}</p>
                    </div>
                  )}

                  <div className="notes-box">
                    <h4>Professional Notes</h4>
                    <p>
                      {request.professional_notes ||
                        "No professional notes added yet."}
                    </p>
                  </div>

                  <div className="request-actions">

                    {request.status === "Pending" && (
                      <>
                        <button
                          onClick={() =>
                            updateStatus(request.id, "Accepted")
                          }
                          className="action-button"
                        >
                          Accept
                        </button>

                        <button
                          onClick={() =>
                            updateStatus(request.id, "Rejected")
                          }
                          className="action-button danger"
                        >
                          Reject
                        </button>
                      </>
                    )}

                    {request.status === "Accepted" && (
                      <button
                        onClick={() =>
                          updateStatus(request.id, "In Progress")
                        }
                        className="action-button"
                      >
                        Start Job
                      </button>
                    )}

                    {request.status === "In Progress" && (
                      <button
                        onClick={() =>
                          updateStatus(request.id, "Completed")
                        }
                        className="action-button"
                      >
                        Mark Completed
                      </button>
                    )}

                    <button
                      onClick={() => updateNotes(request.id)}
                      className="action-button secondary"
                    >
                      Add / Update Notes
                    </button>

                  </div>

                </article>
              ))}
            </div>
          )}
        </section>

      </div>

      <style jsx>{`
