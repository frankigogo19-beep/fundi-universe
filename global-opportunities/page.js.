"use client";

import React, { useMemo, useState } from "react";
import Link from "next/link";

interface Opportunity {
  id: number;
  icon: string;
  title: string;
  description: string;
  details: string;
  category: string;
  actionText: string;
  actionHref: string;
}

const opportunities: Opportunity[] = [
  {
    id: 1,
    icon: "🌍",
    title: "International Business Opportunities",
    description:
      "Discover ways to connect businesses and professionals in Tanzania, Africa and international markets.",
    details:
      "Expand your business reach by connecting directly with verified service providers, suppliers, and corporate clients across East Africa and global trade hubs.",
    category: "Business",
    actionText: "Find Business Partners",
    actionHref: "/professionals",
  },
  {
    id: 2,
    icon: "🤝",
    title: "Global Collaboration",
    description:
      "Build partnerships with customers, skilled professionals and businesses around the world.",
    details:
      "Collaborate on cross-border projects, joint ventures, and remote technical support with trusted professionals on Fundi Universe.",
    category: "Partnerships",
    actionText: "Start Collaborating",
    actionHref: "/signup",
  },
  {
    id: 3,
    icon: "💼",
    title: "Professional Services",
    description:
      "Explore professional services in construction, technology, transport, maintenance and other industries.",
    details:
      "Hire vetted engineers, IT specialists, logistics experts, and certified technicians ready to deliver high-standard services.",
    category: "Services",
    actionText: "Browse Professionals",
    actionHref: "/professionals",
  },
  {
    id: 4,
    icon: "📈",
    title: "Business Partnerships",
    description:
      "Find opportunities to develop business relationships and explore potential international cooperation.",
    details:
      "Position your company for long-term growth through strategic alliances, subcontracting opportunities, and B2B networking.",
    category: "Growth",
    actionText: "Join the Network",
    actionHref: "/signup",
  },
  {
    id: 5,
    icon: "🚀",
    title: "Startup & Innovation",
    description:
      "Explore ideas, innovation and opportunities to grow businesses across different markets.",
    details:
      "Connect with tech innovators, product builders, and growth specialists to turn local solutions into scalable global products.",
    category: "Innovation",
    actionText: "Explore Innovators",
    actionHref: "/professionals",
  },
  {
    id: 6,
    icon: "🌐",
    title: "International Markets",
    description:
      "Learn about markets and potential connections in Tanzania, Kenya, Uganda, Rwanda, the USA, UK, UAE, India and beyond.",
    details:
      "Access regional and global demand across East Africa, the Middle East, Europe, North America, and Asia from one unified platform.",
    category: "Markets",
    actionText: "Get Started Today",
    actionHref: "/signup",
  },
];

const CATEGORIES = ["All", "Business", "Partnerships", "Services", "Growth", "Innovation", "Markets"];

export default function GlobalOpportunitiesPage() {
  const [activeCategory, setActiveCategory] = useState("All");
  const [searchQuery, setSearchQuery] = useState("");
  const [openId, setOpenId] = useState<number | null>(1);

  const filteredOpportunities = useMemo(() => {
    const q = searchQuery.trim().toLowerCase();

    return opportunities.filter((item) => {
      const matchesCategory =
        activeCategory === "All" || item.category === activeCategory;
      if (!matchesCategory) return false;

      if (!q) return true;

      return (
        item.title.toLowerCase().includes(q) ||
        item.description.toLowerCase().includes(q) ||
        item.details.toLowerCase().includes(q) ||
        item.category.toLowerCase().includes(q)
      );
    });
  }, [activeCategory, searchQuery]);

  const toggleItem = (id: number) => {
    setOpenId((prev) => (prev === id ? null : id));
  };

  return (
    <main
      style={{
        minHeight: "100vh",
        background: "#f7f9fc",
        color: "#172033",
        fontFamily: "Arial, sans-serif",
        padding: "40px 6%",
      }}
    >
      <div style={{ maxWidth: "850px", margin: "0 auto" }}>
        {/* Top Bar */}
        <div
          style={{
            display: "flex",
            flexWrap: "wrap",
            alignItems: "center",
            justifyContent: "space-between",
            gap: "12px",
            marginBottom: "28px",
          }}
        >
          <Link
            href="/"
            style={{
              fontSize: "14px",
              fontWeight: "700",
              color: "#1769aa",
              textDecoration: "none",
            }}
          >
            ← Rudi Home
          </Link>

          <div style={{ display: "flex", gap: "16px", alignItems: "center" }}>
            <Link
              href="/professionals"
              style={{
                fontSize: "14px",
                fontWeight: "600",
                color: "#1769aa",
                textDecoration: "none",
              }}
            >
              Find a Professional
            </Link>
            <Link
              href="/help-center"
              style={{
                fontSize: "14px",
                fontWeight: "600",
                color: "#667085",
                textDecoration: "none",
              }}
            >
              Help Center →
            </Link>
          </div>
        </div>

        {/* Header Card */}
        <div
          style={{
            background: "#ffffff",
            padding: "32px",
            borderRadius: "14px",
            border: "1px solid #e5eaf1",
            boxShadow: "0 8px 25px rgba(20, 40, 80, 0.05)",
            textAlign: "center",
            marginBottom: "24px",
          }}
        >
          <p
            style={{
              margin: "0 0 8px",
              fontSize: "12px",
              fontWeight: "700",
              textTransform: "uppercase",
              letterSpacing: "1.2px",
              color: "#1769aa",
            }}
          >
            Connecting Tanzania to the World
          </p>
          <h1 style={{ margin: "0 0 10px", fontSize: "34px", fontWeight: "800" }}>
            Global Opportunities
          </h1>
          <p style={{ margin: 0, fontSize: "16px", color: "#667085", lineHeight: "1.6" }}>
            Discover opportunities to connect people, professionals and businesses across countries, industries and international markets.
          </p>
        </div>

        {/* Search Input */}
        <div style={{ marginBottom: "18px" }}>
          <input
            type="text"
            value={searchQuery}
            onChange={(e) => setSearchQuery(e.target.value)}
            placeholder="Search opportunities, markets, or industries..."
            style={{
              width: "100%",
              boxSizing: "border-box",
              borderRadius: "10px",
              border: "1px solid #d5dce7",
              background: "#ffffff",
              padding: "14px 16px",
              fontSize: "15px",
              color: "#172033",
              outline: "none",
            }}
          />
        </div>

        {/* Category Filter Tabs */}
        <div
          style={{
            display: "flex",
            flexWrap: "wrap",
            gap: "10px",
            marginBottom: "26px",
          }}
        >
          {CATEGORIES.map((cat) => {
            const active = activeCategory === cat;
            return (
              <button
                key={cat}
                type="button"
                onClick={() => setActiveCategory(cat)}
                style={{
                  borderRadius: "8px",
                  padding: "10px 16px",
                  fontSize: "14px",
                  fontWeight: "600",
                  cursor: "pointer",
                  border: active ? "none" : "1px solid #d5dce7",
                  background: active ? "#1769aa" : "#ffffff",
                  color: active ? "#ffffff" : "#172033",
                }}
              >
                {cat}
              </button>
            );
          })}
        </div>

        {/* Accordion List */}
        <div style={{ display: "grid", gap: "12px" }}>
          {filteredOpportunities.length > 0 ? (
            filteredOpportunities.map((item) => {
              const isOpen = openId === item.id;
              return (
                <div
                  key={item.id}
                  style={{
                    borderRadius: "12px",
                    border: "1px solid #e5eaf1",
                    background: "#ffffff",
                    overflow: "hidden",
                    boxShadow: "0 4px 14px rgba(20, 40, 80, 0.03)",
                  }}
                >
                  <button
                    type="button"
                    onClick={() => toggleItem(item.id)}
                    aria-expanded={isOpen}
                    style={{
                      display: "flex",
                      width: "100%",
                      alignItems: "center",
                      justifyContent: "space-between",
                      gap: "16px",
                      padding: "18px 20px",
                      textAlign: "left",
                      background: "#ffffff",
                      border: "none",
                      cursor: "pointer",
                    }}
                  >
                    <div style={{ display: "flex", alignItems: "center", gap: "14px" }}>
                      <span
                        style={{
                          fontSize: "26px",
                          background: "#f0f6fc",
                          width: "48px",
                          height: "48px",
                          borderRadius: "10px",
                          display: "flex",
                          alignItems: "center",
                          justifyContent: "center",
                          flexShrink: 0,
                        }}
                      >
                        {item.icon}
                      </span>
                      <div>
                        <span
                          style={{
                            display: "block",
                            fontSize: "12px",
                            fontWeight: "700",
                            textTransform: "uppercase",
                            color: "#1769aa",
                            marginBottom: "4px",
                          }}
                        >
                          {item.category}
                        </span>
                        <span
                          style={{
                            display: "block",
                            fontSize: "16px",
                            fontWeight: "700",
                            color: "#172033",
                          }}
                        >
                          {item.title}
                        </span>
                      </div>
                    </div>

                    <span
                      style={{
                        fontSize: "22px",
                        fontWeight: "700",
                        color: "#1769aa",
                        flexShrink: 0,
                      }}
                    >
                      {isOpen ? "−" : "+"}
                    </span>
                  </button>

                  {isOpen && (
                    <div
                      style={{
                        borderTop: "1px solid #e5eaf1",
                        padding: "18px 20px",
                        fontSize: "15px",
                        color: "#667085",
                        lineHeight: "1.65",
                        background: "#f9fbfd",
                      }}
                    >
                      <p style={{ margin: "0 0 10px", color: "#172033", fontWeight: "500" }}>
                        {item.description}
                      </p>
                      <p style={{ margin: "0 0 18px", fontSize: "14px" }}>
                        {item.details}
                      </p>
                      <Link
                        href={item.actionHref}
                        style={{
                          display: "inline-block",
                          padding: "10px 18px",
                          borderRadius: "8px",
                          background: "#1769aa",
                          color: "#ffffff",
                          textDecoration: "none",
                          fontWeight: "700",
                          fontSize: "14px",
                        }}
                      >
                        {item.actionText} →
                      </Link>
                    </div>
                  )}
                </div>
              );
            })
          ) : (
            <div
              style={{
                borderRadius: "12px",
                border: "1px solid #e5eaf1",
                background: "#ffffff",
                padding: "30px",
                textAlign: "center",
                fontSize: "15px",
                color: "#667085",
              }}
            >
              No opportunities found matching your search or filter.
            </div>
          )}
        </div>

        {/* Bottom CTA Card */}
        <div
          style={{
            marginTop: "36px",
            borderRadius: "16px",
            background: "#172033",
            padding: "32px 24px",
            textAlign: "center",
            color: "#ffffff",
          }}
        >
          <h2 style={{ fontSize: "22px", fontWeight: "700", margin: "0 0 10px" }}>
            One platform. Professionals worldwide.
          </h2>
          <p style={{ margin: "0 0 20px", color: "#d8deea", fontSize: "15px" }}>
            Join a growing professional network and prepare to explore opportunities across different markets.
          </p>
          <Link
            href="/signup"
            style={{
              display: "inline-block",
              borderRadius: "8px",
              background: "#ffffff",
              padding: "12px 24px",
              fontSize: "14px",
              fontWeight: "700",
              color: "#172033",
              textDecoration: "none",
            }}
          >
            Join Fundi Universe
          </Link>
        </div>
      </div>
    </main>
  );
}
